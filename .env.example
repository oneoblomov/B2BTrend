# Default application language.
APP_DEFAULT_LANGUAGE=tr

# Default keyword or Google Trends Topic ID.
DEFAULT_KEYWORD=/m/02vqb5x

# Google Trends proxies, comma-separated. Optional.
# GOOGLE_TRENDS_PROXIES=https://proxy1:8080,https://proxy2:8080

# Fetch pacing.
FETCH_MIN_SLEEP=4.0
FETCH_MAX_SLEEP=9.0
FETCH_PHASE_COUNTRY_FACTOR=0.75
FETCH_PHASE_CITY_LIST_FACTOR=1.0
FETCH_PHASE_CITY_TIMELINE_FACTOR=1.25
FETCH_BURST_EVERY=10
FETCH_BURST_MIN_SLEEP=10.0
FETCH_BURST_MAX_SLEEP=22.0
FETCH_RETRY_COOLDOWN_BASE=8.0
FETCH_RETRY_COOLDOWN_MAX=120.0

# Persist Google cookie profile to reduce repeated cold-start handshakes.
ENABLE_COOKIE_PROFILE=true
COOKIE_PROFILE_TTL_HOURS=96

# Storage policy.
ENABLE_FETCH_CACHE=true
FETCH_CACHE_TTL_HOURS=12
MAX_CACHE_FILES=250
SAVE_REPORT_HISTORY=true
MAX_REPORT_FILES=25

# Alert threshold.
SPIKE_Z_THRESHOLD=2.5

# Telegram.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=123456789

# Email.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL_TO=recipient@example.com
